APP_NAME="CSC Recruitment System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true       # Must be false in production
APP_URL=http://localhost:8010

# Comma-separated proxy IPs/CIDRs, or '*' to trust every upstream, ONLY if the
# app sits behind a reverse proxy/load balancer that terminates TLS (Nginx,
# an ARR front-end, a CDN). Leave blank for a direct, un-proxied deployment.
# Needed for $request->secure() (and the HSTS header in AddCspHeaders) to see
# HTTPS correctly when the proxy talks plain HTTP to this app internally.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily            # 'single' never rotates or prunes — grows unbounded in production
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug            # Use 'warning' or 'error' in production — 'debug' logs query bindings and other detail

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=csc_recruitment
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false  # Set to true in production (HTTPS)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database    # Use 'redis' in production
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log              # Use 'smtp' with real credentials in production
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Sign-in from the IMIS portal. URL of IMIS POST /api/v1/sso/validate; audience defaults to APP_URL host[:port].
IMIS_SSO_URL=
IMIS_SSO_AUDIENCE=
