# Defense-in-depth for local/XAMPP hosting: this project's document root must
# be public/, never this directory. If Apache is ever pointed at the project
# root directly (e.g. the XAMPP default of serving htdocs/<project> as-is),
# this denies every request instead of quietly serving .env, .git/, vendor/,
# storage/, and composer.json to the internet.
#
# This is a safety net, not a substitute for the real fix: point the vhost's
# DocumentRoot (or an Alias) at public/ instead.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
